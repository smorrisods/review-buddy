{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/_lib/**",
              "components/companion/**",
              "components/core/**",
              "components/desktop/**",
              "components/feedback/**",
              "components/forms/**",
              "components/marketing/**",
              "components/material/**",
              "components/menus/**",
              "ui_kits/cadence/**",
              "ui_kits/flow/**",
              "ui_kits/spindle/**",
              "ui_kits/waypoint/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|Inter|JetBrains Mono|Roboto Flex|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, Inter, JetBrains Mono, Roboto Flex, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmbientLight'] > JSXAttribute > JSXIdentifier[name!=/^(?:fixed|intensity|style|key|ref|className|style|children)$/]",
        "message": "<AmbientLight> doesn't accept that prop. Declared props: fixed, intensity, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackToTop'] > JSXAttribute > JSXIdentifier[name!=/^(?:visible|fixed|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<BackToTop> doesn't accept that prop. Declared props: visible, fixed, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success|info|warning|error|accent|purple)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'success' | 'info' | 'warning' | 'error' | 'accent' | 'purple'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconOnly|disabled|fullWidth|type|title|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconOnly, disabled, fullWidth, type, title, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|primary|secondary|ghost|danger|link)$/]",
        "message": "<Button> variant must be one of 'default' | 'primary' | 'secondary' | 'ghost' | 'danger' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CapacityBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|warnAt|height|label|style|key|ref|className|style|children)$/]",
        "message": "<CapacityBar> doesn't accept that prop. Declared props: value, warnAt, height, label, style."
